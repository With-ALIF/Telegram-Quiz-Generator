{
  "rewrites": [
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/telegram/:action",
      "destination": "/api/telegram?action=:action"
    },
    {
      "source": "/api/quiz/generate",
      "destination": "/api/quiz"
    },
    {
      "source": "/api/quiz/generateFromImage",
      "destination": "/api/quiz"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
